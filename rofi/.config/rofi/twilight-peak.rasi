/* ~/.config/rofi/twilight-peak.rasi  --  Twilight Peak (soft) */

* {
    bg:        #1a1530;
    bg-alt:    #251f40;
    fg:        #d3cae3;
    dim:       #8a7fa8;
    violet:    #8f7bb8;
    rose:      #c9a0b4;

    background-color: transparent;
    text-color:       @fg;
    font:             "LiberationMono 11";
}

configuration {
    show-icons: false;
}

window {
    width:            520px;
    background-color: @bg;
    border:           1px;
    border-color:     @violet;
    border-radius:    10px;
}

mainbox {
    padding:  12px;
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding:          8px 12px;
    spacing:          8px;
    background-color: @bg-alt;
    border-radius:    8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @rose;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @dim;
}

listview {
    lines:        8;
    columns:      1;
    scrollbar:    false;
    spacing:      4px;
    fixed-height: false;
}

element {
    padding:       7px 12px;
    border-radius: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: #3a3166;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

message {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px;
}
