# /etc/default/grub  (source: ~/dotfiles/system/grub/grub, installed by system/grub/install.sh)
# After changing this run:  sudo grub-mkconfig -o /boot/grub/grub.cfg

# ---- boot entry ----
GRUB_DEFAULT=0
GRUB_DISTRIBUTOR="Arch"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_BOOTNEXT=true
GRUB_PRELOAD_MODULES="part_gpt part_msdos"

# ---- menu ----
# 3 s to pick something else (any key stops the countdown)
GRUB_TIMEOUT=3
GRUB_TIMEOUT_STYLE=menu

# ---- look ----
# native panel resolution, falls back to whatever the firmware offers;
# Linux keeps it so there is no flicker/mode switch before the login screen
GRUB_GFXMODE=2560x1600x32,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_TERMINAL_INPUT=console
GRUB_THEME="/boot/grub/themes/ember/theme.txt"

# Uncomment to detect other operating systems (needs os-prober)
#GRUB_DISABLE_OS_PROBER=false
