{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo-tuke.txt",
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#e8732a",
      "title": "#f5ad42",
      "output": "#ecdfcc",
      "separator": "#6b5a4a"
    },
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "os",     "format": "{name}" },
    { "type": "host",     "key": "host",   "format": "{family}" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell",    "key": "shell" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu",      "key": "cpu",    "format": "{name} ({cores-logical})" },
    { "type": "gpu",      "key": "gpu",    "format": "{name}" },
    { "type": "memory",   "key": "memory" },
    { "type": "disk",     "key": "disk",   "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery",  "key": "battery" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
