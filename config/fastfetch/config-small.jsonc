// Compact layout for narrow windows (picked by the fastfetch() function in bashrc).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo-tuke-small.txt",
    "padding": { "top": 0, "left": 1, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#a8bf4a",
      "title": "#a8bf4a",
      "output": "#bdbdbd",
      "separator": "#555555"
    },
    "key": { "width": 8 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "os",     "format": "{name}" },
    { "type": "kernel",   "key": "kernel", "format": "{release}" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pkgs",   "format": "{all}" },
    { "type": "shell",    "key": "shell",  "format": "{pretty-name}" },
    { "type": "wm",       "key": "wm",     "format": "{pretty-name}" },
    { "type": "memory",   "key": "memory", "format": "{used} / {total}" },
    { "type": "battery",  "key": "battery", "format": "{capacity}" },
    { "type": "colors", "symbol": "circle" }
  ]
}
