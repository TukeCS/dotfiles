configuration {
  modi: "drun,run";
  show-icons: true;
  icon-theme: "breeze-dark";
  terminal: "ghostty";
  drun-display-format: "{name}";
  display-drun: "run:";
  display-run: "run";
  font: "JetBrainsMono Nerd Font 11";
}

/* "glow terminal": frosted panel (blurred by Hyprland), near-square, monospace, a "run:"
   prompt; the selected entry is a solid rust bar with dark text so it is always obvious. */
* {
  fg:     #f6ead8;
  dim:    #c9bfb0;
  faint:  #8f8676;
  rust:   #e8732a;
  gold:   #f4b942;
  amber:  #f29a38;
  blue:   #9db8e8;
  red:    #e5534b;
  dark:   #0e0d0c;
  background-color: transparent;
  text-color: @fg;
  margin: 0; padding: 0; spacing: 0;
}

window {
  width: 560px;
  background-color: #0e0d0ca6;
  border: 1px;
  border-color: #f6ead829;
  border-radius: 6px;
}

mainbox  { padding: 16px; spacing: 14px; children: [ inputbar, message, listview ]; }

inputbar { children: [ prompt, entry ]; spacing: 10px; padding: 10px 16px;
           background-color: #f6ead80f; border-radius: 3px;
           border: 0 0 1px 0; border-color: #e8732a66; }
prompt   { text-color: @rust; }
entry    { placeholder: "_"; placeholder-color: @faint; cursor: text; cursor-color: @rust; }

message  { border: 0; padding: 0 4px; }
textbox  { text-color: @gold; }
mode-switcher, button { border: 0; text-color: @dim; }

listview { lines: 8; fixed-height: false; scrollbar: false; spacing: 4px; border: 0; }

element  { padding: 8px 12px; spacing: 12px; children: [ element-icon, element-text ];
           border-radius: 3px; }
element-icon { size: 24px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
element-text, element-icon { background-color: transparent; }

element normal.normal, element alternate.normal { background-color: transparent; text-color: @dim; }
element normal.active, element alternate.active { background-color: transparent; text-color: @blue; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @red; }

element selected.normal { background-color: @rust;  text-color: @dark; }
element selected.active { background-color: @blue;  text-color: @dark; }
element selected.urgent { background-color: @red;   text-color: @dark; }
