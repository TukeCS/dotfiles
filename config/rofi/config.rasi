configuration {
  modi: "drun,run";
  show-icons: true;
  icon-theme: "breeze-dark";
  terminal: "ghostty";
  drun-display-format: "{name}";
  display-drun: "›";
  display-run: "run";
  font: "JetBrainsMono Nerd Font 12";
}

/* Matches the Ly login / hyprlock / mako box: solid black, square, moss-green border,
   input in a dim outlined field, red only for urgent. */
* {
  fg:   #e6e6e6;
  dim:  #666666;
  moss: #a8bf4a;
  red:  #e07a5f;
  background-color: transparent;
  text-color: @fg;
  margin: 0; padding: 0; spacing: 0;
}

window {
  width: 480px;
  background-color: #000000;
  border: 2px;
  border-color: @moss;
  border-radius: 0;
}

mainbox  { padding: 14px; spacing: 12px; children: [ inputbar, message, listview ]; }

/* like the lock screen's password field */
inputbar { children: [ prompt, entry ]; spacing: 10px; padding: 8px 10px;
           border: 1px; border-color: @dim; }
prompt   { text-color: @moss; }
entry    { placeholder: "search"; placeholder-color: @dim; cursor: text; cursor-color: @moss; }

message  { border: 0; padding: 0 4px; }
textbox  { text-color: @dim; }
mode-switcher, button { border: 0; text-color: @dim; }

listview { lines: 8; fixed-height: false; scrollbar: false; spacing: 2px; border: 0; }

element  { padding: 6px 8px; spacing: 10px; children: [ element-icon, element-text ];
           border: 0 0 0 2px; border-color: transparent; }
element-icon { size: 20px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
element-text, element-icon { background-color: transparent; }

element normal.normal, element alternate.normal { background-color: transparent; text-color: @dim; }
element normal.active, element alternate.active { background-color: transparent; text-color: @moss; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @red; }

element selected.normal { background-color: #ffffff0f; text-color: #ffffff; border-color: @moss; }
element selected.active { background-color: #ffffff0f; text-color: @moss;   border-color: @moss; }
element selected.urgent { background-color: #ffffff0f; text-color: @red;    border-color: @red; }
