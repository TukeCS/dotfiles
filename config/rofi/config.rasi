configuration {
  modi: "drun,run";
  show-icons: true;
  icon-theme: "breeze-dark";
  terminal: "ghostty";
  drun-display-format: "{name}";
  display-drun: "›";
  display-run: "run";
  font: "JetBrainsMono Nerd Font 12";
}

* {
  fg:  #e6e6e6;
  dim: #666666;
  background-color: transparent;
  text-color: @fg;
  margin: 0; padding: 0; spacing: 0;
}

window {
  width: 480px;
  background-color: #000000a6;
  border: 1px;
  border-color: #ffffff40;
  border-radius: 0;
}

mainbox  { padding: 14px; spacing: 10px; children: [ inputbar, listview ]; }

inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 0 4px 8px 4px;
           border: 0 0 1px 0; border-color: #ffffff26; }
prompt   { text-color: #a8bf4a; }
entry    { placeholder: ""; cursor: text; }

listview { lines: 8; fixed-height: true; scrollbar: false; spacing: 0; border: 0; }
message, textbox, mode-switcher, button { border: 0; background-color: transparent; text-color: @dim; }
entry { cursor-color: #a8bf4a; }

element  { padding: 6px 6px; spacing: 10px; children: [ element-icon, element-text ]; }
element-icon { size: 20px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }
element-text { text-color: inherit; }
element-text, element-icon { background-color: transparent; }
element normal.normal, element alternate.normal,
element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @dim; }
element selected.normal, element selected.active,
element selected.urgent { background-color: #ffffff14; text-color: #ffffff; border: 0 0 0 2px; border-color: #a8bf4a; }
