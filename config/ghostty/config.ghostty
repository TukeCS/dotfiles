# ---- Theme "oxide": warm black, rust-orange accent (same palette as Neovim and the desktop) ----
font-family = JetBrainsMono Nerd Font
font-size = 12
background = #0e0b09
foreground = #ecdfcc
cursor-color = #e8732a
cursor-text = #0e0b09
# selection: solid rust with dark text, so it is obvious what is selected
selection-background = #e8732a
selection-foreground = #0e0b09

# 16 terminal colours. Hues stay where programs expect them (red = error, green = ok,
# yellow = warning, blue/cyan/magenta distinct) so compiler/git output reads the same,
# just warmer. All readable on the dark background.
palette = 0=#1c1612
palette = 1=#e0463a
palette = 2=#a9b665
palette = 3=#f5ad42
palette = 4=#7fa6c4
palette = 5=#d690ad
palette = 6=#78bfa8
palette = 7=#d9cab4
palette = 8=#8a7564
palette = 9=#f26a5c
palette = 10=#c3d07a
palette = 11=#f7c862
palette = 12=#a3c3db
palette = 13=#e6aec6
palette = 14=#98d4c0
palette = 15=#fff4e3
window-padding-x = 10
window-padding-y = 10
window-decoration = false
# same see-through as the Waybar islands
background-opacity = 0.55
background-blur = true

# ---- Fast window opening ----
# One resident Ghostty process (started by Hyprland at login) serves every window,
# so new terminals skip the GTK cold start. Keybinds use `ghostty +new-window`.
gtk-single-instance = true
quit-after-last-window-closed = false

# ---- Notifications ----
# No "Copied to clipboard" popup when copying; keep the config-reload one.
app-notifications = no-clipboard-copy,config-reload
