# ---- Monochrome theme ----
font-family = JetBrainsMono Nerd Font
font-size = 12
background = #000000
foreground = #e6e6e6
cursor-color = #ffffff
cursor-text = #000000
selection-background = #4f5a24
selection-foreground = #ffffff
window-padding-x = 10
window-padding-y = 10
window-decoration = false
background-opacity = 0.82
background-blur = true

# ---- Fast window opening ----
# One resident Ghostty process (started by Hyprland at login) serves every window,
# so new terminals skip the GTK cold start. Keybinds use `ghostty +new-window`.
gtk-single-instance = true
quit-after-last-window-closed = false

# ---- Notifications ----
# No "Copied to clipboard" popup when copying; keep the config-reload one.
app-notifications = no-clipboard-copy,config-reload
