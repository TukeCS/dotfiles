# btop theme "oxide": warm black, rust frame. Graphs go cool -> hot as load rises
# (patina -> gold -> rust -> red) so usage is readable at a glance.
theme[main_bg]="#0e0b09"
theme[main_fg]="#ecdfcc"
theme[title]="#f5ad42"
theme[hi_fg]="#e8732a"
theme[selected_bg]="#e8732a"
theme[selected_fg]="#0e0b09"
theme[inactive_fg]="#6b5a4a"
theme[graph_text]="#a8927e"
theme[meter_bg]="#2a2019"
theme[proc_misc]="#f7c862"
theme[cpu_box]="#e8732a"
theme[mem_box]="#f5ad42"
theme[net_box]="#8fb2c9"
theme[proc_box]="#c98a5e"
theme[div_line]="#3a2c22"
theme[temp_start]="#78bfa8"
theme[temp_mid]="#f5ad42"
theme[temp_end]="#e0463a"
theme[cpu_start]="#78bfa8"
theme[cpu_mid]="#f5ad42"
theme[cpu_end]="#e0463a"
theme[free_start]="#3d4a2a"
