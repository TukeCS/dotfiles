# Matches the Ly login / hyprlock box: translucent black (like waybar, blurred), square, moss-green border,
# light grey text with dim grey labels, red only for critical.
font=JetBrainsMono Nerd Font 11
background-color=#000000bf
text-color=#e6e6e6
border-color=#a8bf4a
progress-color=over #3b4520
border-size=2
border-radius=0
padding=12,14
margin=20
outer-margin=6
width=380
default-timeout=5000
icons=1
max-icon-size=40
# app name dim like the box labels, summary bold, body below
format=<span foreground="#666666">%a</span>\n<b>%s</b>\n%b

[app-name=""]
format=<b>%s</b>\n%b

[urgency=low]
border-color=#666666
text-color=#a9a9a9

[urgency=critical]
border-color=#e07a5f
default-timeout=0
format=<span foreground="#e07a5f">%a</span>\n<b>%s</b>\n%b
