# "glow terminal": frosted card (blurred by Hyprland), near-square, monospace, thin warm edge,
# cream text with gold app names, red only for critical.
font=JetBrainsMono Nerd Font 10.5
background-color=#0e0d0cb3
text-color=#f6ead8
border-color=#f4b94266
progress-color=over #2f4475
border-size=1
border-radius=4
padding=14,18
margin=20
outer-margin=6
width=380
default-timeout=5000
icons=1
max-icon-size=40
# app name dim like the box labels, summary bold, body below
format=<span foreground="#f4b942">%a</span>\n<b>%s</b>\n%b

[app-name=""]
format=<b>%s</b>\n%b

[urgency=low]
border-color=#f6ead826
text-color=#c9bfb0

[urgency=critical]
border-color=#e5534b
default-timeout=0
format=<span foreground="#e5534b">%a</span>\n<b>%s</b>\n%b
